# Copy to .env next to compose.yaml and fill in.

# The public domain; its DNS A record must point at the instance.
MOVIE_NIGHT_DOMAIN=paste.example.com

# The image to run, e.g. from ECR. Defaults to a locally built image.
# MOVIE_NIGHT_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/movie-night:latest

# Host directory holding all persistent data (the EBS data volume).
# MOVIE_NIGHT_DATA=/var/lib/movie-night

# Lifetime of newly created pastes, in days.
# PASTE_TTL_DAYS=30
