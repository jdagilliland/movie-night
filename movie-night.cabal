cabal-version:      3.0
name:               movie-night
version:            0.1.0.0
synopsis:           Paste text, get a short link
build-type:         Simple
extra-doc-files:    docs/SPEC.md

common shared
  default-language: GHC2021
  default-extensions:
    OverloadedStrings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-deriving-strategies
    -Wpartial-fields
    -Wredundant-constraints
  build-depends:
    base >=4.20 && <5

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    MovieNight

executable movie-night
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    movie-night

test-suite spec
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  other-modules:
    MovieNightSpec
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
  build-tool-depends:
    hspec-discover:hspec-discover
  build-depends:
    movie-night,
    hspec
