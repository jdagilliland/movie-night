cabal-version:      3.0
name:               movie-night
version:            0.1.0.0
synopsis:           Paste text, get a short link
build-type:         Simple
extra-doc-files:    docs/SPEC.md
extra-source-files: static/copy.js

common shared
  default-language: GHC2021
  default-extensions:
    DerivingStrategies
    OverloadedStrings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-deriving-strategies
    -Wpartial-fields
    -Wredundant-constraints
  build-depends:
    base >=4.20 && <5

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    MovieNight.Config
    MovieNight.Content
    MovieNight.Html
    MovieNight.Paste
    MovieNight.PasteId
    MovieNight.Server
    MovieNight.Store
    MovieNight.Store.Memory
    MovieNight.Store.SQLite
  build-depends:
    bytestring,
    containers,
    crypton,
    directory,
    file-embed,
    filepath,
    http-api-data,
    http-media,
    http-types,
    lucid,
    servant,
    servant-lucid,
    servant-server,
    sqlite-simple,
    text,
    time,
    wai,
    wai-extra

executable movie-night
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    movie-night,
    optparse-applicative,
    time,
    wai-extra,
    warp

test-suite spec
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  other-modules:
    MovieNight.ConfigSpec
    MovieNight.ContentSpec
    MovieNight.PasteIdSpec
    MovieNight.ServerSpec
    MovieNight.Store.MemorySpec
    MovieNight.Store.SQLiteSpec
    MovieNight.StoreContract
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
  build-tool-depends:
    hspec-discover:hspec-discover
  build-depends:
    movie-night,
    bytestring,
    filepath,
    hspec,
    hspec-wai,
    http-types,
    QuickCheck,
    sqlite-simple,
    temporary,
    text,
    time,
    wai,
    wai-extra
