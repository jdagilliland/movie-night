# Copy to terraform.tfvars (git-ignored) and fill in.

# A named AWS profile; omit to use the environment (e.g. AWS_PROFILE). Use
# the same profile in backend.hcl.
aws_profile = "default"

domain         = "paste.example.com"
ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

# The Route 53 hosted zone for the domain, if it was registered (or is
# hosted) in Route 53. Omit to manage DNS elsewhere.
route53_zone_name = "example.com"

admin_cidrs    = ["203.0.113.7/32"]
alert_email    = "you@example.com"

# Defaults, shown for reference:
# instance_type       = "t4g.nano"
# availability_zone   = "us-east-1a"
# data_volume_size_gb = 1
# snapshot_retention  = 7
# monthly_budget_usd  = 10
# paste_ttl_days      = 30
